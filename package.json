{
  "name": "lz-work-bootstrap",
  "version": "0.1.0",
  "description": "薄编排插件：按 plugins.md / skills.md 编排插件安装、Skill 同步、失败续跑、验证与移除墓碑",
  "license": "MIT",
  "author": "fangfengxiang",
  "repository": {
    "type": "git",
    "url": "https://github.com/fangfengxiang/lz-work-bootstrap.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test build-tests/tests/*.test.js",
    "smoke": "node build-tests/smoke.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
